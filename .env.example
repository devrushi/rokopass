NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/rokidspass?schema=public"
CORS_ORIGIN=*
JWT_ACCESS_SECRET="replace-with-a-random-64-char-hex-string"
