generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev/tests; the rhel-openssl targets cover Netlify Functions' AWS
  // Lambda runtime (both OpenSSL versions included since the exact base image can change with
  // Netlify's own Node runtime updates) — see AGENTS.md.
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PARENT
  PROVIDER
  ADMIN
  // A school looking for vetted activity providers to work with — see SchoolProviderApproval.
  SCHOOL
}

// Name predates the SCHOOL role but the states apply identically — both PROVIDER and SCHOOL
// accounts start PENDING and need admin approval before full access, so this wasn't renamed.
enum ProviderVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                      String                      @id @default(uuid())
  email                   String                      @unique
  passwordHash            String
  firstName               String
  lastName                String
  role                    UserRole                    @default(PARENT)
  verificationStatus      ProviderVerificationStatus?
  stripeCustomerId        String?                     @unique
  // E.164-ish (e.g. "+441234567890"), used to build a wa.me deep link for parents to message a
  // provider directly — not a real WhatsApp Business API integration, see AGENTS.md.
  whatsappNumber          String?
  // Plain "call this number" contact, shown as a tel: link — distinct from whatsappNumber since
  // not every provider phone (e.g. a landline) can take a WhatsApp deep link.
  phoneNumber             String?
  // Provider marketing links, shown on their public activity pages. Plain URLs, not a real
  // social API integration (posting/reading requires per-platform developer credentials this
  // project doesn't have) — same class of seam as whatsappNumber above.
  instagramUrl            String?
  facebookUrl             String?
  tiktokUrl               String?
  websiteUrl              String?
  // Provider safeguarding record — self-reported by the provider, reviewed by an admin before
  // approval. Not a live DBS registry check (that requires official umbrella-body registration,
  // not just an API key); see AGENTS.md for the MVP-vs-real-verification note.
  dbsCertificateNumber    String?
  dbsCertificateExpiresAt DateTime?
  // Stripe Connect (Express) — how a PROVIDER actually receives their payout statement's net
  // amount. Created lazily on first onboarding-link request, not at registration, since most
  // providers won't touch this until they have real earnings. payoutsEnabled/detailsSubmitted
  // are synced from Stripe's `account.updated` webhook, not set directly — see
  // src/routes/webhooks.ts and AGENTS.md.
  stripeConnectAccountId  String?                     @unique
  connectDetailsSubmitted Boolean                     @default(false)
  connectPayoutsEnabled   Boolean                     @default(false)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  activities         Activity[]
  subscription       Subscription?
  creditTransactions CreditTransaction[]
  children           Child[]
  bookings           Booking[]
  auditLogs          AuditLog[]

  schoolApprovalsGiven    SchoolProviderApproval[] @relation("SchoolApprovalsGiven")
  schoolApprovalsReceived SchoolProviderApproval[] @relation("SchoolApprovalsReceived")

  businessProfile  ProviderBusinessProfile?
  payoutStatements PayoutStatement[]
  expenses         ProviderExpense[]
}

enum SchoolApprovalStatus {
  SHORTLISTED
  APPROVED
  REJECTED
}

// A school's own vetting decision about a provider — separate from the platform's own
// PROVIDER verificationStatus. A school sees the provider's RokidsPass verification/DBS status
// as a starting signal (reduces the school's own admin burden of vetting from scratch) and
// records its own decision here, scoped per school so different schools can reach different
// conclusions about the same provider.
model SchoolProviderApproval {
  id         String               @id @default(uuid())
  schoolId   String
  school     User                 @relation("SchoolApprovalsGiven", fields: [schoolId], references: [id])
  providerId String
  provider   User                 @relation("SchoolApprovalsReceived", fields: [providerId], references: [id])
  status     SchoolApprovalStatus
  notes      String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([schoolId, providerId])
  @@index([providerId])
}

model AgeGroup {
  id        String   @id @default(uuid())
  label     String   @unique
  minAge    Int
  maxAge    Int
  createdAt DateTime @default(now())

  activities Activity[]
}

model Activity {
  id         String   @id @default(uuid())
  providerId String
  provider   User     @relation(fields: [providerId], references: [id])
  ageGroupId String
  ageGroup   AgeGroup @relation(fields: [ageGroupId], references: [id])

  title          String
  description    String
  category       String
  location       String
  capacity       Int
  creditCost     Int
  isActive       Boolean  @default(true)
  isFlagged      Boolean  @default(false)
  isFeatured     Boolean  @default(false)
  // Provider-declared: this activity is run in a way suitable for children with special
  // educational needs/disabilities. Self-reported, not independently verified — a filter/badge,
  // not a certification.
  isSendFriendly Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  recurringSchedules RecurringSchedule[]
  sessions           ClassSession[]
  media              ActivityMedia[]

  @@index([providerId])
  @@index([ageGroupId])
}

enum MediaType {
  ACTIVITY_PHOTO
  STAFF_PHOTO
}

// Uploaded files are stored on local disk (see src/lib/upload.ts) with this row pointing at the
// public URL — a placeholder for a real object-storage provider (S3/Cloudinary/etc.) later,
// same pattern as src/lib/email.ts's seam for a real email provider.
model ActivityMedia {
  id         String    @id @default(uuid())
  activityId String
  activity   Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  type       MediaType
  url        String
  caption    String?
  createdAt  DateTime  @default(now())

  @@index([activityId])
}

enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
}

model RecurringSchedule {
  id              String              @id @default(uuid())
  activityId      String
  activity        Activity            @relation(fields: [activityId], references: [id], onDelete: Cascade)
  dayOfWeek       Int
  startTime       String
  durationMinutes Int
  frequency       RecurrenceFrequency @default(WEEKLY)
  startDate       DateTime
  endDate         DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  sessions ClassSession[]

  @@index([activityId])
}

model ClassSession {
  id                  String             @id @default(uuid())
  activityId          String
  activity            Activity           @relation(fields: [activityId], references: [id], onDelete: Cascade)
  recurringScheduleId String?
  recurringSchedule   RecurringSchedule? @relation(fields: [recurringScheduleId], references: [id], onDelete: SetNull)

  startsAt    DateTime
  endsAt      DateTime
  capacity    Int
  isCancelled Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]

  @@unique([recurringScheduleId, startsAt])
  @@index([activityId, startsAt])
}

model Child {
  id              String   @id @default(uuid())
  parentId        String
  parent          User     @relation(fields: [parentId], references: [id])
  firstName       String
  lastName        String
  dateOfBirth     DateTime
  // Special-category health data (UK GDPR) — free text set by the parent, only ever exposed to
  // the specific provider running a session this child is booked into (via the roster/attendees
  // endpoint), never in any public or cross-provider listing. See AGENTS.md.
  allergyInfo     String?
  // Opt-in, default false — a child only appears on the leaderboard if a parent explicitly
  // turns this on, and even then only as "Firstname L." (see src/services/leaderboard.ts).
  isOnLeaderboard Boolean  @default(false)
  // Optional, parent-uploaded — same local-disk seam as activity/staff photos (see
  // src/lib/upload.ts). Only ever shown to the child's own parent and, if isOnLeaderboard is
  // also on, on the leaderboard alongside the same "Firstname L." pseudonym — never full name.
  photoUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings Booking[]

  @@index([parentId])
}

enum BookingStatus {
  PENDING_APPROVAL
  CONFIRMED
  CANCELLED
  REJECTED
  ATTENDED
  NO_SHOW
}

// A booking transactionally pairs a capacity check (session.capacity vs. PENDING_APPROVAL +
// CONFIRMED bookings) with a credit deduction (a CreditTransaction insert) — see
// src/services/booking.ts. Credits are deducted up front at request time, not at approval time,
// so the capacity/balance check stays inside the one SERIALIZABLE transaction; approving is a
// pure status change, rejecting/cancelling refunds via a BOOKING_REFUND transaction.
model Booking {
  id           String        @id @default(uuid())
  childId      String
  child        Child         @relation(fields: [childId], references: [id])
  sessionId    String
  session      ClassSession  @relation(fields: [sessionId], references: [id])
  parentId     String
  parent       User          @relation(fields: [parentId], references: [id])
  status       BookingStatus @default(PENDING_APPROVAL)
  creditsSpent Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  creditTransactions  CreditTransaction[]
  payoutStatementLine PayoutStatementLine?

  @@unique([childId, sessionId])
  @@index([sessionId])
  @@index([parentId])
}

enum PlanAudience {
  PARENT
  PROVIDER
}

// PARENT plans are real Stripe-billed credit packs (monthlyCredits/stripePriceId set,
// maxActiveActivities null). PROVIDER plans are informational business tiers admin
// assigns/manages directly — no Stripe billing yet, so stripePriceId stays null and
// maxActiveActivities carries the tier's listing limit instead of monthlyCredits.
model Plan {
  id                  String       @id @default(uuid())
  audience            PlanAudience @default(PARENT)
  name                String       @unique
  description         String
  monthlyCredits      Int?
  priceGbp            Int // pence, e.g. 2999 = £29.99
  stripePriceId       String?      @unique
  maxActiveActivities Int?
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

// One row per user, mutated over its lifecycle rather than versioned per Stripe subscription —
// this platform supports a single active plan per user at a time. Switching plans updates this
// row rather than creating a new one, so subscription history beyond "current state" isn't
// retained. See AGENTS.md if that changes.
model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id])
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  creditTransactions CreditTransaction[]
}

enum CreditTransactionReason {
  SUBSCRIPTION_INITIAL
  SUBSCRIPTION_RENEWAL
  BOOKING
  BOOKING_REFUND
  ADMIN_ADJUSTMENT
  // A parent donates spare credits into the community fund (negative, on the donor's ledger)
  // and an admin grants pooled credits to a family in need (positive, on the recipient's
  // ledger). The fund's available balance is computed on read from these two reasons — no
  // separate mutable balance column — see src/services/charity.ts.
  CHARITY_DONATION
  CHARITY_GRANT
}

// A user's credit balance is the sum of their transactions, not a mutable counter — an
// append-only ledger avoids lost updates under concurrent writes and keeps a full audit trail
// of every grant/deduction. See src/services/creditBalance.ts.
model CreditTransaction {
  id             String                  @id @default(uuid())
  userId         String
  user           User                    @relation(fields: [userId], references: [id])
  subscriptionId String?
  subscription   Subscription?           @relation(fields: [subscriptionId], references: [id])
  bookingId      String?
  booking        Booking?                @relation(fields: [bookingId], references: [id])
  amount         Int
  reason         CreditTransactionReason
  createdAt      DateTime                @default(now())

  @@index([userId])
}

// Processed Stripe webhook event IDs, so a retried delivery (Stripe retries on non-2xx/timeout,
// and "at least once" delivery means duplicates are possible even without a retry) never gets
// applied twice.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

enum AuditAction {
  PROVIDER_APPROVED
  PROVIDER_REJECTED
  ACTIVITY_FLAGGED
  ACTIVITY_UNFLAGGED
  ACTIVITY_FEATURED
  ACTIVITY_UNFEATURED
  CHARITY_GRANT_ISSUED
}

// Every admin moderation action writes one row here — the "audit logs" the approve/reject and
// flag/feature endpoints are required to keep. Read via GET /admin/audit-log.
model AuditLog {
  id         String      @id @default(uuid())
  adminId    String
  admin      User        @relation(fields: [adminId], references: [id])
  action     AuditAction
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([targetType, targetId])
  @@index([adminId])
}

// ---------------------------------------------------------------------------------------------
// Provider accounting / HMRC bookkeeping
//
// A UK sole trader or limited company must keep records of business income and expenses (Income
// Tax Self Assessment / Corporation Tax), and — if VAT-registered — issue VAT invoices showing
// their VAT number, the rate charged, and the VAT amount. Records must be kept for at least
// 5 years after the 31 January Self Assessment deadline they relate to (in practice, ~6 years) —
// see AGENTS.md. Nothing in this section is tax advice; it gives providers accurate, exportable
// records to hand to their own accountant or use for their own Self Assessment/VAT return.
// ---------------------------------------------------------------------------------------------

// A provider's legal/tax identity — distinct from their User profile (which is their platform
// login/display identity). Required before a payout statement can be generated for them, since
// HMRC-compliant invoices must show the seller's legal name and address.
model ProviderBusinessProfile {
  id                String   @id @default(uuid())
  providerId        String   @unique
  provider          User     @relation(fields: [providerId], references: [id])
  legalBusinessName String
  addressLine1      String
  addressLine2      String?
  city              String
  postcode          String
  country           String   @default("GB")
  // HMRC Unique Taxpayer Reference — informational only, never validated or transmitted
  // anywhere; stored so it appears alongside a provider's own exported records if they want it.
  utr               String?
  isVatRegistered   Boolean  @default(false)
  vatNumber         String?
  vatRatePercent    Int      @default(20)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Singleton config row (fixed id) an admin edits — the credit→£ rate and the platform's
// commission/VAT position, all of which feed into every payout statement generated from this
// point forward. Never mutated retroactively on old statements (see PayoutStatement's own
// snapshot fields) — changing a rate here only affects statements generated after the change.
model PlatformSettings {
  id                     String   @id @default("singleton")
  // Pence per credit — there is no other £-per-credit conversion anywhere in the system (credits
  // are an abstract ledger unit; see CreditTransaction), so this is the one place a provider's
  // earnings are given a cash value.
  creditValueGbp         Int      @default(250)
  commissionRatePercent  Int      @default(15)
  platformLegalName      String   @default("Roshelia Ltd")
  platformAddress        String   @default("Leicester, United Kingdom")
  platformVatRegistered  Boolean  @default(false)
  platformVatNumber      String?
  platformVatRatePercent Int      @default(20)
  updatedAt              DateTime @updatedAt
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

// One statement per provider per period (typically a calendar month) — the combined "you earned
// this much, we took this much commission (+ VAT on our commission if we're VAT-registered),
// here's your net payout" document, generated from ATTENDED/NO_SHOW bookings (credits
// irrecoverably spent — see src/services/payouts.ts) not yet included in an earlier statement.
// Every money/identity field a real invoice needs is snapshotted at generation time rather than
// joined live, because an invoice is a legal record that must not silently change if the
// provider edits their business profile or an admin changes the commission rate later.
model PayoutStatement {
  id         String @id @default(uuid())
  providerId String
  provider   User   @relation(fields: [providerId], references: [id])

  // Sequential, human-readable, unique — e.g. "STMT-2026-000123". HMRC invoices must have a
  // unique identifying number; this doubles as that number for the commission-VAT-invoice
  // portion of the statement.
  statementNumber String   @unique
  periodStart     DateTime
  periodEnd       DateTime

  creditsRedeemed        Int
  creditValueGbpSnapshot Int // pence per credit, at generation time
  grossAmountGbp         Int // pence — creditsRedeemed * creditValueGbpSnapshot

  commissionRatePercentSnapshot Int
  commissionAmountGbp           Int // pence
  commissionVatGbp              Int @default(0) // pence — 0 unless the platform is VAT-registered
  netAmountGbp                  Int // pence — gross - commission - commissionVat; the Stripe transfer amount

  providerLegalName String
  providerAddress   String
  providerVatNumber String?

  platformLegalName String
  platformAddress   String
  platformVatNumber String?

  status           PayoutStatus @default(PENDING)
  stripeTransferId String?
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime     @default(now())

  lines PayoutStatementLine[]

  @@index([providerId])
}

// One row per booking included in a statement — the itemised detail behind the statement's
// totals, and the mechanism that prevents a booking from ever being paid out twice (bookingId is
// unique). Snapshots the activity title and session date so the line still makes sense even if
// the activity is later edited or deleted.
model PayoutStatementLine {
  id                String          @id @default(uuid())
  payoutStatementId String
  payoutStatement   PayoutStatement @relation(fields: [payoutStatementId], references: [id], onDelete: Cascade)
  bookingId         String          @unique
  booking           Booking         @relation(fields: [bookingId], references: [id])

  activityTitle   String
  sessionStartsAt DateTime
  // "Firstname L." — same pseudonymization convention as the leaderboard (see
  // src/services/leaderboard.ts); a provider's payout statement doesn't need a child's full name
  // to be useful, and bookingId is there for full traceability if ever needed.
  childInitials   String
  creditsSpent    Int
  amountGbp       Int // pence

  @@index([payoutStatementId])
}

enum ExpenseCategory {
  COST_OF_GOODS
  CAR_VAN_TRAVEL
  STAFF_WAGES
  RENT_RATES_UTILITIES
  REPAIRS_MAINTENANCE
  ADVERTISING_MARKETING
  LEGAL_PROFESSIONAL
  OFFICE_ADMIN
  OTHER
}

// Self-reported business expenses a provider logs for their own record-keeping — categories
// mirror HMRC's SA103 self-employment expense categories so a provider (or their accountant) can
// map this export straight onto a Self Assessment return. Purely a ledger; nothing here moves
// money or is verified/audited by the platform.
model ProviderExpense {
  id          String          @id @default(uuid())
  providerId  String
  provider    User            @relation(fields: [providerId], references: [id])
  category    ExpenseCategory
  description String
  amountGbp   Int // pence
  incurredOn  DateTime
  receiptUrl  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([providerId])
}
